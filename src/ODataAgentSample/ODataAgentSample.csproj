<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OData" Version="9.4.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.OData.Core" Version="8.4.3" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.5.4" />
    <PackageReference Include="Microsoft.OpenApi.OData" Version="3.2.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
  </ItemGroup>

  <!-- Seed-Daten aus dem Original-ODataSample, als Ressourcen in die Assembly eingebettet -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\*.json" LogicalName="Data.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ODataAgentSample.Tests" />
  </ItemGroup>

</Project>
